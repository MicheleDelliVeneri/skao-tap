        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>from_column</name>
        <description>referencing column</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>target_column</name>
        <description>referenced column</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <foreignKey>
        <targetTable>tap_schema.keys</targetTable>
        <fkColumn>
          <fromColumn>key_id</fromColumn>
          <targetColumn>key_id</targetColumn>
        </fkColumn>
        <description>key membership</description>
      </foreignKey>
    </table>
  </schema>
  <schema>
    <name>ska</name>
    <description>Example SKAO science tables</description>
    <table type="table">
      <name>ska.continuum_sources</name>
      <description>Example radio continuum source catalogue</description>
      <column>
        <name>source_id</name>
        <description>unique source identifier</description>
        <ucd>meta.id;meta.main</ucd>
        <dataType xsi:type="vod:VOTableType">long</dataType>
      </column>
      <column>
        <name>source_name</name>
        <description>IAU-style source name</description>
        <ucd>meta.id</ucd>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>ra</name>
        <description>Right ascension (ICRS)</description>
        <unit>deg</unit>
        <ucd>pos.eq.ra;meta.main</ucd>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>dec</name>
        <description>Declination (ICRS)</description>
        <unit>deg</unit>
        <ucd>pos.eq.dec;meta.main</ucd>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>flux_peak</name>
        <description>Peak flux density</description>
        <unit>mJy/beam</unit>
        <ucd>phot.flux.density;em.radio</ucd>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>flux_int</name>
        <description>Integrated flux density</description>
        <unit>mJy</unit>
        <ucd>phot.flux.density;em.radio</ucd>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>maj_axis</name>
        <description>Fitted major axis</description>
        <unit>arcsec</unit>
        <ucd>phys.angSize.smajAxis</ucd>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>min_axis</name>
        <description>Fitted minor axis</description>
        <unit>arcsec</unit>
        <ucd>phys.angSize.sminAxis</ucd>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>pos_angle</name>
        <description>Fitted position angle</description>
        <unit>deg</unit>
        <ucd>pos.posAng</ucd>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>spectral_index</name>
        <description>Fitted spectral index</description>
        <ucd>spect.index</ucd>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>obs_date</name>
        <description>Observation date</description>
        <ucd>time.epoch</ucd>
        <dataType xsi:type="vod:VOTableType" arraysize="*" extendedType="timestamp">char</dataType>
      </column>
    </table>
  </schema>
  <schema>
    <name>ivoa</name>
    <description>IVOA standard tables</description>
    <table type="view">
      <name>ivoa.obscore</name>
      <description>ObsCore 1.1: one row per data product of the ingested ODP metadata</description>
      <utype>ivo://ivoa.net/std/ObsCore#core-1.1</utype>
      <column>
        <name>dataproduct_type</name>
        <description>Data product (file content) primary type</description>
        <ucd>meta.code.class</ucd>
        <utype>obscore:ObsDataset.dataProductType</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>calib_level</name>
        <description>Calibration level as declared by the SRCNet producer, passed through untranslated (srcnet: 0=raw, 1=calibrated, 2=science-ready, 3=analysis)</description>
        <ucd>meta.code;obs.calib</ucd>
        <utype>obscore:ObsDataset.calibLevel</utype>
        <dataType xsi:type="vod:VOTableType">int</dataType>
      </column>
      <column>
        <name>obs_collection</name>
        <description>Name of the data collection</description>
        <ucd>meta.id</ucd>
        <utype>obscore:DataID.collection</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>obs_id</name>
        <description>Internal ID given by the ObsTAP service</description>
        <ucd>meta.id</ucd>
        <utype>obscore:DataID.observationID</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>obs_publisher_did</name>
        <description>ID for the Dataset given by the publisher</description>
        <ucd>meta.ref.ivoid</ucd>
        <utype>obscore:Curation.publisherDID</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>access_url</name>
        <description>URL used to access the dataset</description>
        <ucd>meta.ref.url</ucd>
        <utype>obscore:Access.reference</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>access_format</name>
        <description>Content format of the dataset</description>
        <ucd>meta.code.mime</ucd>
        <utype>obscore:Access.format</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>access_estsize</name>
        <description>Estimated size of the dataset in kilobytes</description>
        <unit>kbyte</unit>
        <ucd>phys.size;meta.file</ucd>
        <utype>obscore:Access.size</utype>
        <dataType xsi:type="vod:VOTableType">long</dataType>
      </column>
      <column>
        <name>target_name</name>
        <description>Object of interest</description>
        <ucd>meta.id;src</ucd>
        <utype>obscore:Target.name</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>s_ra</name>
        <description>Central spatial position in ICRS: right ascension</description>
        <unit>deg</unit>
        <ucd>pos.eq.ra</ucd>
        <utype>obscore:Char.SpatialAxis.Coverage.Location.Coord.Position2D.Value2.C1</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>s_dec</name>
        <description>Central spatial position in ICRS: declination</description>
        <unit>deg</unit>
        <ucd>pos.eq.dec</ucd>
        <utype>obscore:Char.SpatialAxis.Coverage.Location.Coord.Position2D.Value2.C2</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>s_fov</name>
        <description>Estimated size of the covered region (diameter)</description>
        <unit>deg</unit>
        <ucd>phys.angSize;instr.fov</ucd>
        <utype>obscore:Char.SpatialAxis.Coverage.Bounds.Extent.diameter</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>s_region</name>
        <description>Sky region covered by the data product (STC-S)</description>
        <ucd>pos.outline;obs.field</ucd>
        <utype>obscore:Char.SpatialAxis.Coverage.Support.Area</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*" extendedType="adql:REGION">char</dataType>
      </column>
      <column>
        <name>s_resolution</name>
        <description>Spatial resolution of the data (FWHM)</description>
        <unit>arcsec</unit>
        <ucd>pos.angResolution</ucd>
        <utype>obscore:Char.SpatialAxis.Resolution.Refval.value</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>s_xel1</name>
        <description>Number of elements along the first coordinate of the spatial axis</description>
        <ucd>meta.number</ucd>
        <utype>obscore:Char.SpatialAxis.numBins1</utype>
        <dataType xsi:type="vod:VOTableType">long</dataType>
      </column>
      <column>
        <name>s_xel2</name>
        <description>Number of elements along the second coordinate of the spatial axis</description>
        <ucd>meta.number</ucd>
        <utype>obscore:Char.SpatialAxis.numBins2</utype>
        <dataType xsi:type="vod:VOTableType">long</dataType>
      </column>
      <column>
        <name>t_min</name>
        <description>Start time in MJD</description>
        <unit>d</unit>
        <ucd>time.start;obs.exposure</ucd>
        <utype>obscore:Char.TimeAxis.Coverage.Bounds.Limits.StartTime</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>t_max</name>
        <description>Stop time in MJD</description>
        <unit>d</unit>
        <ucd>time.end;obs.exposure</ucd>
        <utype>obscore:Char.TimeAxis.Coverage.Bounds.Limits.StopTime</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>t_exptime</name>
        <description>Total exposure time</description>
        <unit>s</unit>
        <ucd>time.duration;obs.exposure</ucd>
        <utype>obscore:Char.TimeAxis.Coverage.Support.Extent</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>t_resolution</name>
        <description>Temporal resolution (FWHM)</description>
        <unit>s</unit>
        <ucd>time.resolution</ucd>
        <utype>obscore:Char.TimeAxis.Resolution.Refval.value</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>t_xel</name>
        <description>Number of elements along the time axis</description>
        <ucd>meta.number</ucd>
        <utype>obscore:Char.TimeAxis.numBins</utype>
        <dataType xsi:type="vod:VOTableType">long</dataType>
      </column>
      <column>
        <name>em_min</name>
        <description>Start in spectral coordinates (vacuum wavelength)</description>
        <unit>m</unit>
        <ucd>em.wl;stat.min</ucd>
        <utype>obscore:Char.SpectralAxis.Coverage.Bounds.Limits.LoLimit</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>em_max</name>
        <description>Stop in spectral coordinates (vacuum wavelength)</description>
        <unit>m</unit>
        <ucd>em.wl;stat.max</ucd>
        <utype>obscore:Char.SpectralAxis.Coverage.Bounds.Limits.HiLimit</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>em_res_power</name>
        <description>Spectral resolving power</description>
        <ucd>spect.resolution</ucd>
        <utype>obscore:Char.SpectralAxis.Resolution.ResolPower.refVal</utype>
        <dataType xsi:type="vod:VOTableType">double</dataType>
      </column>
      <column>
        <name>em_xel</name>
        <description>Number of elements along the spectral axis</description>
        <ucd>meta.number</ucd>
        <utype>obscore:Char.SpectralAxis.numBins</utype>
        <dataType xsi:type="vod:VOTableType">long</dataType>
      </column>
      <column>
        <name>o_ucd</name>
        <description>Nature of the observable axis</description>
        <ucd>meta.ucd</ucd>
        <utype>obscore:Char.ObservableAxis.ucd</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>pol_states</name>
        <description>List of polarization states or NULL if not applicable</description>
        <ucd>meta.code;phys.polarization</ucd>
        <utype>obscore:Char.PolarizationAxis.stateList</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>pol_xel</name>
        <description>Number of polarization samples</description>
        <ucd>meta.number</ucd>
        <utype>obscore:Char.PolarizationAxis.numBins</utype>
        <dataType xsi:type="vod:VOTableType">long</dataType>
      </column>
      <column>
        <name>facility_name</name>
        <description>Name of the facility used for this observation</description>
        <ucd>meta.id;instr.tel</ucd>
        <utype>obscore:Provenance.ObsConfig.Facility.name</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>instrument_name</name>
        <description>Name of the instrument used for this observation</description>
        <ucd>meta.id;instr</ucd>
        <utype>obscore:Provenance.ObsConfig.Instrument.name</utype>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>s_region_geom</name>
        <description>pgsphere footprint derived from s_region at ingestion (non-standard); query it with INTERSECTS/CONTAINS</description>
        <ucd>pos.outline;obs.field</ucd>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
    </table>
  </schema>
  <schema>
    <name>srcnet</name>
    <description>SKA SRC metadata, generated from the SRC data models</description>
    <table type="table">
      <name>srcnet.projects</name>
      <description>Root model for SRC Ingestion Notification files.  This represents the
hierarchical structure: project_id -&gt; obs_id -&gt; sbd_id -&gt; eb_id -&gt; product_id -&gt;
artifact_id  The unique identifier for data products is constructed from:
eb_id.product_id</description>
      <column>
        <name>schema_version</name>
        <description>Version of the schema this payload conforms to</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>project_id</name>
        <description>Project identifier</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>group_ids</name>
        <description>Group IDs that have access to this data</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>project_title</name>
        <description>Human-readable title for the project</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>pi_name</name>
        <description>Principal Investigator name</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>data_rights</name>
        <description>Access rights for the data (public, proprietary, private)</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
    </table>
    <table type="table">
      <name>srcnet.software</name>
      <description>software</description>
      <column>
        <name>uri</name>
        <description>Format: {publisher}:{name}:{version} where version is semver</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
