    <table type="table">
      <name>tap_schema.columns</name>
      <description>Columns of the published tables</description>
      <column>
        <name>table_name</name>
        <description>table the column belongs to</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>column_name</name>
        <description>column name</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>datatype</name>
        <description>ADQL datatype</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>arraysize</name>
        <description>VOTable arraysize</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>xtype</name>
        <description>extended type</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>"size"</name>
        <description>deprecated: use arraysize</description>
        <dataType xsi:type="vod:VOTableType">int</dataType>
      </column>
      <column>
        <name>description</name>
        <description>brief description</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>utype</name>
        <description>utype if column maps a model</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>unit</name>
        <description>unit (VOUnits)</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>ucd</name>
        <description>UCD of the column</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>indexed</name>
        <description>1 if indexed</description>
        <dataType xsi:type="vod:VOTableType">int</dataType>
      </column>
      <column>
        <name>principal</name>
        <description>1 if principal column</description>
        <dataType xsi:type="vod:VOTableType">int</dataType>
      </column>
      <column>
        <name>std</name>
        <description>1 if defined by a standard</description>
        <dataType xsi:type="vod:VOTableType">int</dataType>
      </column>
      <column>
        <name>column_index</name>
        <description>recommended sort order</description>
        <dataType xsi:type="vod:VOTableType">int</dataType>
      </column>
      <foreignKey>
        <targetTable>tap_schema.tables</targetTable>
        <fkColumn>
          <fromColumn>table_name</fromColumn>
          <targetColumn>table_name</targetColumn>
        </fkColumn>
        <description>column membership</description>
      </foreignKey>
    </table>
    <table type="table">
      <name>tap_schema.keys</name>
      <description>Foreign keys between published tables</description>
