        <name>key_id</name>
        <description>unique key identifier</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>from_table</name>
        <description>referencing table</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>target_table</name>
        <description>referenced table</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>utype</name>
        <description>utype of the key</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>description</name>
        <description>brief description</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <foreignKey>
        <targetTable>tap_schema.tables</targetTable>
        <fkColumn>
          <fromColumn>from_table</fromColumn>
          <targetColumn>table_name</targetColumn>
        </fkColumn>
        <description>referencing table</description>
      </foreignKey>
      <foreignKey>
        <targetTable>tap_schema.tables</targetTable>
        <fkColumn>
          <fromColumn>target_table</fromColumn>
          <targetColumn>table_name</targetColumn>
