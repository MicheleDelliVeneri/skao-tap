      <column>
        <name>table_name</name>
        <description>fully qualified table name</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>table_type</name>
        <description>table or view</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>utype</name>
        <description>utype if table maps a model</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>description</name>
        <description>brief description</description>
        <dataType xsi:type="vod:VOTableType" arraysize="*">char</dataType>
      </column>
      <column>
        <name>table_index</name>
        <description>recommended sort order</description>
        <dataType xsi:type="vod:VOTableType">int</dataType>
